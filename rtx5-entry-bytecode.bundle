        label: 'Pattern ' + formatDelta(points[points.length - 1].price - points[0].price),
        labelBackgroundColor: 'rgba(88, 28, 135, 0.92)',
        labelTextColor: '#F3E8FF'
      });
    }
  });
`
  };
