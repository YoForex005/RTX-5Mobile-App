  /**
   * Pure date / calendar helpers for the history filter calendar grid.
   */

  var PRESETS = ['All time', 'Today', 'Last week', 'Last month', 'Last 3 months', 'Last 6 months', 'Last year', 'Custom'];
  var DAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
  var MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  function getDaysInMonth(year, month) {
    return new Date(year, month + 1, 0).getDate();
  }
  function getFirstDayOfMonth(year, month) {
    var day = new Date(year, month, 1).getDay();
    return day === 0 ? 6 : day - 1; // Monday-first
  }
  function getWeekDates(date) {
    var day = date.getDay();
    var mondayOffset = day === 0 ? -6 : 1 - day;
    var monday = new Date(date);
    monday.setDate(date.getDate() + mondayOffset);
    var sunday = new Date(monday);
    sunday.setDate(monday.getDate() + 6);
    return [monday, sunday];
  }
  function toDateKey(year, month, day) {
    return `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
  }
  function formatDate(d) {
    return `${d.getDate()} ${MONTHS[d.getMonth()].slice(0, 3)} ${d.getFullYear()}`;
  }
  function formatLocalizedDate(d, locale) {
    try {
      return new Intl.DateTimeFormat(locale, {
        day: 'numeric',
        month: 'short',
        year: 'numeric'
      }).format(d);
    } catch {
      return formatDate(d);
    }
  }
  function formatMonthYear(year, month, locale) {
    try {
      return new Intl.DateTimeFormat(locale, {
        month: 'long',
        year: 'numeric'
      }).format(new Date(year, month, 1));
    } catch {
      return `${MONTHS[month]} ${year}`;
    }
  }
  function getWeekdayLabels(locale) {
    try {
      var formatter = new Intl.DateTimeFormat(locale, {
        weekday: 'short'
      });
      var monday = new Date(2021, 7, 2);
      return DAYS.map((_, offset) => {
        var day = new Date(monday);
        day.setDate(monday.getDate() + offset);
        return formatter.format(day);
      });
    } catch {
      return DAYS;
    }
  }
