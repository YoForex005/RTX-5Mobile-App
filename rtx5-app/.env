# RTX5 Environment Variables (Development)

# REST API
# EXPO_PUBLIC_API_BASE_URL=http://69.197.178.27/api/v2
EXPO_PUBLIC_API_BASE_URL=https://backend.orrnn.com/api/v2
# WebSocket Services (all wss:// — cleartext would be blocked by Android's
# network security config on release APKs, matching the https API scheme).
EXPO_PUBLIC_QUOTES_WS_URL=wss://backend.orrnn.com/ws/feed
EXPO_PUBLIC_CANDLES_WS_URL=wss://backend.orrnn.com/ws/feed
EXPO_PUBLIC_ACCOUNT_WS_URL=wss://backend.orrnn.com/ws/v2
EXPO_PUBLIC_WS_URL=wss://backend.orrnn.com/ws
