# RTX5 Environment Variables (Production / Dynamic)

# Platform/pre-auth REST API (never used as an authenticated broker fallback)
EXPO_PUBLIC_API_BASE_URL=https://superbackend.orrnn.com/api/v2

# Broker Directory Services (V2)
# Used exclusively to fetch the initial list of active broker servers.
EXPO_PUBLIC_BROKER_DIRECTORY_BASE_URL=https://superbackend.orrnn.com/api/v2

# Public Demo Account Services (V1)
# superbackend does not currently host /public/demo-* routes.
EXPO_PUBLIC_DEMO_API_BASE_URL=https://backend.orrnn.com/api/v1

# Legacy market-data feed token (old flow). Used when login does not return
# feed_token / feed_auth_context. Paste your shared feed token after the =.
# Prefer backend-issued session feed tokens long-term; this ships in the app.
EXPO_PUBLIC_FEED_BROKER_TOKEN=orrnn-central-lp-20260602-3f6e9b8d6acb4b96a42f0d51e9c7a14c
# Optional: limit env token to one broker id (empty = all brokers).
# EXPO_PUBLIC_FEED_BROKER_ID=myprop-trade

# Candle history REST contract (broker-relative under active session apiBase /api/v2)
# Live MyProp: GET /api/v2/candles/{symbol}?timeframe=M1&limit=5
EXPO_PUBLIC_CANDLE_HISTORY_PATH=candles
EXPO_PUBLIC_CANDLE_HISTORY_QUERY_STYLE=timeframeLimit

# Broker-scoped SL/TP capabilities remain explicitly fail-closed until one
# exact deployed broker contract is verified.
EXPO_PUBLIC_BROKER_SLTP_CAPABILITIES='{}'

# Legal
EXPO_PUBLIC_TERMS_URL=https://rtx5.orrnn.com/terms-conditions
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://rtx5.orrnn.com/privacy-policy

# Sentry error reporting
EXPO_PUBLIC_SENTRY_DSN=https://3dab2efca640377d8759f471e3452523@o4511568602464256.ingest.us.sentry.io/4511568799531008
