# RTX5 Environment Variables (Production / Dynamic)

# Default REST API fallback (used before a broker is selected)
EXPO_PUBLIC_API_BASE_URL=https://superbackend.orrnn.com/api/v2

# Broker Directory Services (V1)
# Used exclusively to fetch the initial list of active broker servers.
EXPO_PUBLIC_BROKER_DIRECTORY_BASE_URL=https://superbackend.orrnn.com/api/v1

# Public Demo Account Services (V1)
# superbackend does not currently host /public/demo-* routes.
EXPO_PUBLIC_DEMO_API_BASE_URL=https://backend.orrnn.com/api/v1

# Legal
EXPO_PUBLIC_TERMS_URL=https://rtx5.orrnn.com/terms-conditions
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://rtx5.orrnn.com/privacy-policy
