{
  "name": "rtx5-app",
  "version": "1.1.30",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node ./scripts/android/start-dev-client-usb.js --go --tunnel",
    "start:lan": "node ./scripts/android/start-dev-client-usb.js --go --lan",
    "start:tunnel": "node ./scripts/android/start-dev-client-usb.js --go --tunnel",
    "start:android:usb": "node ./scripts/android/start-dev-client-usb.js --go --localhost",
    "open:android": "node ./scripts/android/start-dev-client-usb.js --go --reuse-only",
    "start:dev-client:usb": "node ./scripts/android/start-dev-client-usb.js --dev-client --localhost",
    "android": "node ./scripts/android/run-android.js",
    "bootstrap:android": "powershell -ExecutionPolicy Bypass -File .\\scripts\\android\\bootstrap-android-sdk.ps1",
    "doctor:android": "node ./scripts/android/doctor-android.js",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node ./scripts/run-all-tests.js",
    "test:quick": "node ./scripts/run-tsx-cli.js --test src/domain/candles/rendering/candleGeometry.test.ts",
    "test:interaction": "node ./scripts/run-tsx-cli.js --test src/features/settings/brokerDetailLaunchController.test.ts src/features/settings/brokersLaunchController.test.ts src/features/settings/registerLaunchController.test.ts src/features/settings/savedAccountSwitchHealthCache.test.ts src/features/settings/accountsSwitchSource.test.ts src/features/settings/accountConnectionStatus.test.ts src/features/trade/tradeAuthGateSource.test.ts src/features/settings/BrokersScreen/brokerDirectoryRows.test.ts src/features/settings/BrokersScreen/brokersScreenSource.test.ts src/features/chart/drawingToolsActionSheetSource.test.ts src/features/quotes/quotesActionSheetPressState.test.ts src/ui/components/ActionSheet/retainedActionSheetVisualController.test.ts src/ui/components/ActionSheet/actionSheetParityContract.test.ts src/ui/components/ActionSheet/layout.test.ts src/ui/components/ActionSheet/search.test.ts src/state/uiStateActionSheet.test.ts src/utils/appActionLatencyContract.test.ts src/utils/tabNavigationPerformance.test.ts src/utils/sidebarNavigationPerformance.test.ts src/utils/loginInteractionPerformance.test.ts src/utils/errorBoundaryReliability.test.ts src/utils/apiLatencyContract.test.ts src/utils/apiLatency.test.ts src/utils/hiddenScreenWorkContract.test.ts src/utils/navigation.test.ts",
    "test:chart-geometry": "node ./scripts/run-tsx-cli.js --test src/domain/candles/rendering/candleGeometry.test.ts",
    "test:stability": "node ./scripts/run-tsx-cli.js --test tests/candle-engine/*.test.ts tests/chart-webview/*.test.ts",
    "prebuild": "expo prebuild",
    "build:dev": "node ./scripts/run-eas-cli.js build --platform all --profile development --non-interactive",
    "build:preview": "node ./scripts/run-eas-cli.js build --platform all --profile preview --non-interactive",
    "build:staging": "node ./scripts/run-eas-cli.js build --platform all --profile staging --non-interactive",
    "build:prod": "node ./scripts/run-eas-cli.js build --platform all --profile production --non-interactive",
    "build:prod:no-ota": "node ./scripts/run-eas-cli.js build --platform all --profile production-no-ota --non-interactive --clear-cache",
    "build:android:prod": "node ./scripts/run-eas-cli.js build --platform android --profile production --non-interactive",
    "build:android:prod-apk": "node ./scripts/run-eas-cli.js build --platform android --profile production-apk --non-interactive",
    "build:android:prod-no-ota-apk": "node ./scripts/run-eas-cli.js build --platform android --profile production-no-ota-apk --non-interactive --clear-cache",
    "build:android": "node ./scripts/run-eas-cli.js build --platform android --profile preview --non-interactive",
    "build:ios": "node ./scripts/run-eas-cli.js build --platform ios --profile preview --non-interactive",
    "update:preview": "node ./scripts/eas-update.js preview",
    "update:staging": "node ./scripts/eas-update.js staging",
    "update:prod": "node ./scripts/eas-update.js production",
    "ota:context": "node ./scripts/ota/print-update-context.js",
    "ota:check-env": "node ./scripts/ota/check-eas-env.js",
    "ota:check-safe": "node ./scripts/ota/check-ota-safety.js",
    "submit:ios": "node ./scripts/run-eas-cli.js submit --platform ios",
    "submit:android": "node ./scripts/run-eas-cli.js submit --platform android",
    "submit:all": "node ./scripts/run-eas-cli.js submit --platform all",
    "bundle:charts": "node scripts/bundle-lightweight-charts.js",
    "postinstall": "node scripts/patch-react-native-dev-middleware.js && node scripts/patch-expo-ngrok-timeout.js && node scripts/patch-expo-start.js && node scripts/bundle-lightweight-charts.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@sentry/react-native": "~7.2.0",
    "@shopify/react-native-skia": "2.2.12",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~54.0.36",
    "expo-application": "~7.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "lightweight-charts": "^5.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.1",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.5.1",
    "reanimated-color-picker": "^4.2.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^54.0.10",
    "ts-morph": "^28.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
