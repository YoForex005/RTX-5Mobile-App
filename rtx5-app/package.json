{
  "name": "rtx5-app",
  "version": "1.1.10",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:android:usb": "node ./scripts/android/start-dev-client-usb.js",
    "android": "node ./scripts/android/run-android.js",
    "bootstrap:android": "powershell -ExecutionPolicy Bypass -File .\\scripts\\android\\bootstrap-android-sdk.ps1",
    "doctor:android": "node ./scripts/android/doctor-android.js",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "npx --yes tsx --test src/domain/candles/rendering/candleGeometry.test.ts",
    "test:interaction": "npx --yes tsx --test src/features/settings/brokerDetailLaunchController.test.ts src/features/settings/brokersLaunchController.test.ts src/features/settings/BrokersScreen/brokerDirectoryRows.test.ts src/features/settings/BrokersScreen/brokersScreenSource.test.ts src/utils/appActionLatencyContract.test.ts src/utils/tabNavigationPerformance.test.ts src/utils/sidebarNavigationPerformance.test.ts src/utils/loginInteractionPerformance.test.ts src/utils/errorBoundaryReliability.test.ts src/utils/apiLatencyContract.test.ts src/utils/apiLatency.test.ts src/utils/hiddenScreenWorkContract.test.ts",
    "test:chart-geometry": "npx --yes tsx --test src/domain/candles/rendering/candleGeometry.test.ts",
    "test:stability": "npx --yes tsx --test tests/candle-engine/*.test.ts tests/chart-webview/*.test.ts",
    "prebuild": "expo prebuild",
    "build:dev": "eas build --platform all --profile development --non-interactive",
    "build:preview": "eas build --platform all --profile preview --non-interactive",
    "build:staging": "eas build --platform all --profile staging --non-interactive",
    "build:prod": "eas build --platform all --profile production --non-interactive",
    "build:prod:no-ota": "eas build --platform all --profile production-no-ota --non-interactive --clear-cache",
    "build:android:prod": "eas build --platform android --profile production --non-interactive",
    "build:android:prod-apk": "eas build --platform android --profile production-apk --non-interactive",
    "build:android:prod-no-ota-apk": "eas build --platform android --profile production-no-ota-apk --non-interactive --clear-cache",
    "build:android": "eas build --platform android --profile preview --non-interactive",
    "build:ios": "eas build --platform ios --profile preview --non-interactive",
    "update:preview": "node ./scripts/eas-update.js preview",
    "update:staging": "node ./scripts/eas-update.js staging",
    "update:prod": "node ./scripts/eas-update.js production",
    "ota:context": "node ./scripts/ota/print-update-context.js",
    "ota:check-env": "node ./scripts/ota/check-eas-env.js",
    "ota:check-safe": "node ./scripts/ota/check-ota-safety.js",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "submit:all": "eas submit --platform all",
    "bundle:charts": "node scripts/bundle-lightweight-charts.js",
    "postinstall": "node scripts/patch-react-native-dev-middleware.js && node scripts/bundle-lightweight-charts.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@sentry/react-native": "^8.14.0",
    "@shopify/react-native-skia": "2.2.12",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~54.0.35",
    "expo-application": "~7.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "lightweight-charts": "^5.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.1",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.5.1",
    "reanimated-color-picker": "^4.2.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/react-native": "^0.72.8",
    "babel-preset-expo": "^54.0.10",
    "ts-morph": "^28.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
