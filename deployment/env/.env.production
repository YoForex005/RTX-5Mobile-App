# ═══════════════════════════════════════════════════════════════════════════════
# RTX5 — Production Environment
# ═══════════════════════════════════════════════════════════════════════════════
# Profile:   production
# Channel:   production
# Audience:  Public end users
# Distribution: App Store / Google Play Store
#
# ⚠️  WARNING: Do NOT commit real production secrets here.
# ⚠️  Use EAS Secrets for API keys, signing credentials, and tokens.
#     Command: eas secret:create --name <KEY> --value <VAL> --scope project
# ═══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=production

# ── REST API ──────────────────────────────────────────────────────────────────
# Production API — should use HTTPS and a proper domain
EXPO_PUBLIC_API_BASE_URL=https://api.rtx5trade.com/api/v2

# ── WebSocket Services ────────────────────────────────────────────────────────
# Production WebSockets — should use WSS (TLS encrypted)
EXPO_PUBLIC_QUOTES_WS_URL=wss://ws.rtx5trade.com/ws/feed
EXPO_PUBLIC_CANDLES_WS_URL=wss://ws.rtx5trade.com/ws/feed
EXPO_PUBLIC_ACCOUNT_WS_URL=wss://ws.rtx5trade.com:8090/ws/v2
EXPO_PUBLIC_WS_URL=wss://ws.rtx5trade.com/ws

# ── Debug & Logging ───────────────────────────────────────────────────────────
# ALL debug features DISABLED in production
EXPO_PUBLIC_ENABLE_DEBUG_TOOLS=false
EXPO_PUBLIC_LOG_LEVEL=error
