# ── Application ───────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=staging

# ── REST API ──────────────────────────────────────────────────────────────────
# Point to staging backend if available, otherwise use shared backend
EXPO_PUBLIC_API_BASE_URL=http://69.197.178.27/api/v2

# ── WebSocket Services ────────────────────────────────────────────────────────
EXPO_PUBLIC_QUOTES_WS_URL=ws://69.197.178.27/ws/feed
EXPO_PUBLIC_CANDLES_WS_URL=ws://69.197.178.27/ws/feed
EXPO_PUBLIC_ACCOUNT_WS_URL=ws://69.197.178.27:8090/ws/v2
EXPO_PUBLIC_WS_URL=wss://rtxbackend.tradecopier.org/ws

# ── Debug & Logging ───────────────────────────────────────────────────────────
# Debug tools DISABLED in staging to mirror production behavior
EXPO_PUBLIC_ENABLE_DEBUG_TOOLS=false
EXPO_PUBLIC_LOG_LEVEL=warn
