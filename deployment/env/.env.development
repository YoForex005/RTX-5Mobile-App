# ── Application ───────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development

# ── REST API ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=http://69.197.178.27/api/v2

# ── WebSocket Services ────────────────────────────────────────────────────────
EXPO_PUBLIC_QUOTES_WS_URL=ws://69.197.178.27/ws/feed
EXPO_PUBLIC_CANDLES_WS_URL=ws://69.197.178.27/ws/feed
EXPO_PUBLIC_ACCOUNT_WS_URL=ws://69.197.178.27:8090/ws/v2
EXPO_PUBLIC_WS_URL=wss://rtxbackend.tradecopier.org/ws

# ── Debug & Logging ───────────────────────────────────────────────────────────
EXPO_PUBLIC_ENABLE_DEBUG_TOOLS=true
EXPO_PUBLIC_LOG_LEVEL=debug
